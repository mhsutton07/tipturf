# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Developer bypass
# Layer 1: local dev only — add to .env.local, never commit
NEXT_PUBLIC_BYPASS_PAYWALL=false

# Layer 2: staging/prod testers — set in Vercel env vars, never commit to source
DEV_BYPASS_EMAILS=

# App URL — used for Stripe redirect URLs; must match deployment origin
NEXT_PUBLIC_APP_URL=
